    [
        {
            "command": "duplicateTab",
            "id": "User.DuplicateTabCwd",
            "name": "New tab: same cwd"
        },
        {
            "command": 
            {
                "action": "moveFocus",
                "direction": "down"
            },
            "id": "User.FocusDown"
        },
        {
