        },
        {
            "id": "User.ResizeDown",
            "keys": "alt+shift+j"
        },
        {
            "id": "User.ResizeUp",
            "keys": "alt+shift+k"
        },
        {
            "id": "User.ResizeRight",
            "keys": "alt+shift+l"
        },
        {
            "id": "User.PrevMark",
            "keys": "ctrl+up"
        },
        {
            "id": "User.NextMark",
            "keys": "ctrl+down"
        },
        {
            "id": null,
            "keys": "ctrl+c"
        },
        {
            "id": null,
            "keys": "ctrl+v"
